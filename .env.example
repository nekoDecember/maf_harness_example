# OpenAI or an OpenAI-compatible endpoint (including LiteLLM)
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1
# For LiteLLM, for example: http://localhost:4000/v1
OPENAI_BASE_URL=

# chat_completions is the most broadly compatible option for LiteLLM.
# Set responses only when the endpoint implements the OpenAI Responses API.
MAF_CLIENT=chat_completions

# Model token budgets used by Harness compaction.
MAF_CONTEXT_WINDOW_TOKENS=128000
MAF_MAX_OUTPUT_TOKENS=16384

# Official Harness loop iterations per batch. The host automatically starts
# another batch while task_finish has not been called.
MAF_LOOP_ITERATIONS_PER_BATCH=20

# Ask the user after this many still-unfinished batches. With the defaults this
# means a safety check after at most 80 autonomous agent iterations.
MAF_AUTO_BATCHES_BEFORE_PROMPT=4
MAF_API_RETRIES=3

# The agent can only read/write below this directory.
MAF_WORKSPACE=./workspace
MAF_CHECKPOINT=./.state/session.json
